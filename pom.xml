	<ns0:scm>
		<ns0:connection>scm:git:https://github.com/easy-4-java/${project.artifactId}.git</ns0:connection>
		<ns0:developerConnection>scm:git:https://github.com/easy-4-java/${project.artifactId}.git</ns0:developerConnection>
		<ns0:url>https://github.com/easy-4-java/${project.artifactId}</ns0:url>
		<ns0:tag>${project.artifactId}</ns0:tag>
