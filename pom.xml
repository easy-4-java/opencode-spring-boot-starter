		</ns0:dependency>
		
		<ns0:dependency>
			<ns0:groupId>org.springframework.boot</ns0:groupId>
			<ns0:artifactId>spring-boot-autoconfigure</ns0:artifactId>
		</ns0:dependency>

		
		<ns0:dependency>
            <ns0:groupId>io.github.easy4j</ns0:groupId>
			<ns0:artifactId>opencode-java-sdk</ns0:artifactId>
			<ns0:version>${opencode-java-sdk.version}</ns0:version>
		</ns0:dependency>

	</ns0:dependencies>

</ns0:project>