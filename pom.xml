		</ns0:dependency>

		
		<ns0:dependency>
			<ns0:groupId>org.springframework.boot</ns0:groupId>
			<ns0:artifactId>spring-boot-starter</ns0:artifactId>
			<ns0:exclusions>
				<ns0:exclusion>
					<ns0:groupId>org.springframework.boot</ns0:groupId>
					<ns0:artifactId>spring-boot-starter-logging</ns0:artifactId>
				</ns0:exclusion>
